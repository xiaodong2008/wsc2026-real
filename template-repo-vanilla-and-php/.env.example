# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored, so your own credentials stay on your machine. The deployed
# configuration lives in .env.prod instead — the container's entrypoint copies
# that file over .env when it starts.
#
# These values are the ONLY place the database connection is configured. Nothing
# is hardcoded in config/db.php, the Dockerfile or docker-compose.yml: the
# compose file reads the values below to start the local MySQL server, and the
# app reads the same values to connect to it. Change them in one place.

DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app

# Only used by docker-compose.yml to initialise the local MySQL container.
# The deployed database is managed for you, so .env.prod has no equivalent.
DB_ROOT_PASSWORD=root

# Running PHP on your own machine instead of in the container? The database is
# published on localhost, so use DB_HOST=127.0.0.1 rather than the service name.
