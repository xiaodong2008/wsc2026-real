# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored, so it stays on your machine. The deployed configuration
# lives in .env.prod instead — docker-entrypoint.sh copies it over .env when the
# container starts.
#
# This file is the ONLY place the connection is configured. Nothing is hardcoded
# in server.js, the Dockerfile or docker-compose.yml.

# The app's connection string. Prisma reads this, and so does `npm run db:migrate`.
DATABASE_URL="mysql://app:app@db:3306/app"

# The same local database, spelled out for the MySQL container that
# docker-compose.yml starts. Keep these in step with DATABASE_URL above — they
# describe one database, and Compose cannot pull the parts out of a URL itself.
# The deployed database is managed for you, so .env.prod needs none of these.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# Running node on your own machine instead of in the container? The database is
# published on localhost, so use mysql://app:app@127.0.0.1:3306/app.
